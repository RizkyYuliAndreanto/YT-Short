# ============================================
# YT-Short-Clipper Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys
# JANGAN commit file .env ke git!

# ============================================
# 9router Local API (http://localhost:20128/v1)
# Untuk: Highlight Finder, Hook Maker, Title Generator
# ============================================
NINE_ROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# GROQ API (GRATIS - https://console.groq.com/keys)
# Untuk: Highlight Finder, Caption Maker, Title Generator
# ============================================
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# OpenRouter API (https://openrouter.ai/keys)
# Alternatif: Akses 100+ model dengan satu API key
# ============================================
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# OpenAI API (https://platform.openai.com/api-keys)
# Untuk: TTS (hook audio), Whisper (jika tidak pakai Groq)
# ============================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Google Gemini API (https://aistudio.google.com/app/apikey)
# ============================================
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Anthropic Claude API (https://console.anthropic.com/)
# ============================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
